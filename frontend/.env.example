# Copy to .env. Values must match backend/.env REVERB_* settings.
VITE_REVERB_APP_KEY=
# Leave HOST empty to use the page's hostname (works for LAN phones too).
VITE_REVERB_HOST=
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
# Optional: the address phones use in QR codes and invite links (e.g. a tunnel URL).
# Leave empty to use this page's address, or the PC's LAN IP when opened at localhost.
VITE_PUBLIC_URL=
